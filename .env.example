# ── Trust Bazar — environment template ─────────────────────────────
# Copy to .env (gitignored) and fill real values. Single file at repo
# root is read by backend (scripts + server). Never commit secrets.

# ── Core ────────────────────────────────────────────────────────────
NODE_ENV=development
APP_BASE_URL=https://app.trustbazar.com
PORT=4000
# Run background BullMQ workers inside the API process (true|false)
WORKER=true
COOKIE_DOMAIN=.trustbazar.com

# ── MongoDB Atlas ───────────────────────────────────────────────────
# App cluster (M10, Atlas Search enabled)
MONGO_APP_URI=mongodb+srv://user:password@app-cluster.mongodb.net/trustbazar
# Separate audit cluster (M0/M2, append-only DB user)
MONGO_AUDIT_URI=mongodb+srv://audit-user:password@audit-cluster.mongodb.net/trustbazar_audit

# ── Redis (Upstash) ─────────────────────────────────────────────────
REDIS_URL=rediss://default:password@host.upstash.io:6379

# ── Crypto ──────────────────────────────────────────────────────────
# openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# HMAC pepper for nidHash — rotate only with re-hash migration
PEPPER=
# AES-256-GCM field key, 32 bytes hex — via KMS in production
ENCRYPTION_KEY=

# ── Cloudflare R2 ───────────────────────────────────────────────────
# local = on-disk dev driver (signed /media/blob URLs); r2 = presigned S3 PUT
STORAGE_DRIVER=local
# Only used when STORAGE_DRIVER=local (defaults to ./.media)
MEDIA_LOCAL_DIR=
# Shared secret for POST /internal/media/:id/process (worker → API)
INTERNAL_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_KYC=trustbazar-kyc
R2_BUCKET_LISTINGS=trustbazar-listings
R2_BUCKET_PROFILE=trustbazar-profile
# Public base URL for clean listing/profile media (KYC stays private)
R2_PUBLIC_URL=https://media.trustbazar.com

# ── Wasabi (KYC archive after 90d) ─────────────────────────────────
WASABI_ACCESS_KEY_ID=
WASABI_SECRET_ACCESS_KEY=
WASABI_BUCKET=trustbazar-kyc-archive
WASABI_REGION=ap-southeast-1
WASABI_ENDPOINT=https://s3.ap-southeast-1.wasabisys.com

# ── Porichoy (e-KYC) ───────────────────────────────────────────────
PORICHOY_BASE_URL=https://sandbox.porichoy.example.com
PORICHOY_API_KEY=
PORICHOY_WEBHOOK_SECRET=

# ── Atlas Search (PROMPT 10) ────────────────────────────────────────
# false → /listings/search serves the degraded regex fallback (X-Degraded)
ATLAS_SEARCH_ENABLED=false
ATLAS_SEARCH_INDEX=listings_search
# Atlas Admin API keys (install index: pnpm -C backend atlas:search)
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=
ATLAS_GROUP_ID=
ATLAS_CLUSTER_NAME=Cluster0

# ── SMS (primary + secondary failover) ─────────────────────────────
SMS_PRIMARY_BASE_URL=https://api.sslwireless.example.com
SMS_PRIMARY_API_KEY=
SMS_PRIMARY_SENDER_ID=TrustBazar
SMS_SECONDARY_BASE_URL=https://api.alphasms.example.com
SMS_SECONDARY_API_KEY=
SMS_SECONDARY_SENDER_ID=TrustBazar

# ── bKash ───────────────────────────────────────────────────────────
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_WEBHOOK_SECRET=

# ── Nagad ───────────────────────────────────────────────────────────
NAGAD_BASE_URL=https://sandbox.mynagad.com
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_KEY=
NAGAD_WEBHOOK_SECRET=

# ── Push ────────────────────────────────────────────────────────────
FCM_SERVER_KEY=
